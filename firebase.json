{
  "hosting": {
    "site": "johnrusselguiwan",
    "public": "shared/build/dist/wasmJs/productionExecutable",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map"],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/devdeck.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/composeResources/com.example.devdeck.shared.generated.resources/files/portfolio.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
